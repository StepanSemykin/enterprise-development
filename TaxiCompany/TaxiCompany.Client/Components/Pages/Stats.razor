@page "/stats"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Stats</PageTitle>

<h1 class="text-center">Statistics</h1>

<EditForm Model="@formModel" FormName="StatsForm">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label for="start-date" class="form-label">Start date</label>
        <InputDate id="start-date" class="form-control" @bind-Value="formModel.startDate" />
        <ValidationMessage For="@(() => formModel.startDate)" />
    </div>

    <div class="mb-3">
        <label for="end-date" class="form-label">End date</label>
        <InputDate id="end-date" class="form-control" @bind-Value="formModel.endDate" />
        <ValidationMessage For="@(() => formModel.endDate)" />
    </div>

    <div class="mb-3">
        <label for="driver-id" class="form-label">Driver</label>
        <InputSelect id="driver-id" class="form-control" @bind-Value="formModel.driverId">
            <option value="0">Select driver</option>
            @foreach (var driver in _drivers)
            {
                <option value="@driver.Id">@driver.FullName</option>
            }
        </InputSelect>
    </div>

    <div class="mt-3">
        <button class="btn btn-secondary" type="button" @onclick="@(() => LoadClientsStatsAsync())">Load clients stats</button>
        <button class="btn btn-secondary" type="button" @onclick="@(() => LoadTripCountsAsync())">Load trip counts</button>
        <button class="btn btn-secondary" type="button" @onclick="@(() => LoadTopDriversAsync())">Load top drivers</button>
        <button class="btn btn-secondary" type="button" @onclick="@(() => LoadDriverTripStatsAsync())">Load driver trip stats</button>
        <button class="btn btn-secondary" type="button" @onclick="@(() => LoadTopClientsAsync())">Load top clients</button>
        <button class="btn btn-secondary" type="button" @onclick="@(() => LoadDriverAndCarInfo())">Load driver and car info</button>
        <button class="btn btn-secondary" type="button" @onclick="ClearForm">Clear</button>
    </div>

</EditForm>

@if (_clients != null && _clients.Any())
{
    <h3 class="mt-4">Loaded Clients</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>FullName</th>
                <th>PhoneNumber</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in _clients)
            {
                <tr>
                    <td>@client.Id</td>
                    <td>@client.FullName</td>
                    <td>@client.PhoneNumber</td>
                </tr>
            }
        </tbody>
    </table>
}
else if ((_clients != null && !_clients.Any()) && _showClients)
{
    <p>No clients found for the selected date range</p>
}

@if (_tripCounts != null && _tripCounts.Any())
{
    <h3 class="mt-4">Trip counts</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Full name</th>
                <th>Phone number</th>
                <th>Trip count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var tripCount in _tripCounts)
            {
                if (tripCount.Client != null)
                {
                    <tr>
                        <td>@tripCount.Client.FullName</td>
                        <td>@tripCount.Client.PhoneNumber</td>
                        <td>@tripCount.TripCount</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="3">No client data available</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else if ((_tripCounts != null && !_tripCounts.Any()) && _showTripCounts)
{
    <p>No trip counts found</p>
}

@if (_topDrivers != null && _topDrivers.Any())
{
    <h3 class="mt-4">Top drivers</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Full name</th>
                <th>Trip count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var driver in _topDrivers)
            {
                if (driver.Driver != null)
                {
                    <tr>
                        <td>@driver.Driver.FullName</td>
                        <td>@driver.TripCount</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="2">No driver data available</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else if ((_topDrivers != null && !_topDrivers.Any()) && _showTopDrivers)
{
    <p>No top drivers found</p>
}

@if (_driverStats != null && _driverStats.Any())
{
    <h3 class="mt-4">Driver trip stats</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Full name</th>
                <th>Trip count</th>
                <th>Average driving time</th>
                <th>Max driving time</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var driverStat in _driverStats)
            {
                if (driverStat.Driver != null)
                {
                    <tr>
                        <td>@driverStat.Driver.FullName</td>
                        <td>@driverStat.TripCount</td>
                        <td>@driverStat.AverageDrivingTime</td>
                        <td>@driverStat.MaxDrivingTime</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="4">No driver data available</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else if ((_driverStats != null && !_driverStats.Any()) && _showDriverStats)
{
    <p>No driver stats found</p>
}

@if (_topClients != null && _topClients.Any())
{
    <h3 class="mt-4">Top clients</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Full name</th>
                <th>Phone number</th>
                <th>Trip count</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in _topClients)
            {
                if (client.Client != null)
                {
                    <tr>
                        <td>@client.Client.FullName</td>
                        <td>@client.Client.PhoneNumber</td>
                        <td>@client.TripCount</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="3">No client data available</td>
                    </tr>
                }
            }
        </tbody>
    </table>
}
else if ((_topClients != null && !_topClients.Any()) &&  _showTopClients)
{
    <p>No top clients found</p>
}

@if (_driverCarInfo != null && _driverCarInfo.Driver != null && _driverCarInfo.Car != null)
 {
     <h3 class="mt-4">Driver and car info</h3>
     <table class="table">
         <thead>
             <tr>
                 <th>Full name</th>
                 <th>Car model</th>
                 <th>Car colour</th>
                 <th>Serial number</th>
                 <th>Release year</th>
             </tr>
         </thead>
         <tbody>
             <tr>
                 <td>@_driverCarInfo.Driver.FullName</td>
                 <td>@_driverCarInfo.Car.Model</td>
                 <td>@_driverCarInfo.Car.Colour</td>
                 <td>@_driverCarInfo.Car.SerialNumber</td>
                <td>@_driverCarInfo.Car.ReleaseYear.ToString("dd-MM-yyyy")</td>
             </tr>
         </tbody>
     </table>
 }
 else if (_driverCarInfo == null && _showDriverCarInfo)
 {
     <p>No driver and car info found</p>
 }

@code 
{
    private List<Client> _clients = new();
    private List<ClientTripCountDto> _tripCounts = new();
    private List<DriverTripCountDto> _topDrivers = new();
    private List<DriverTripStatsDto> _driverStats = new();
    private List<ClientTripCountDto> _topClients = new();
    private DriverCarInfoDto _driverCarInfo = new();
    private List<Driver> _drivers = new();

    private DateTime _startDate = DateTime.Now;
    private DateTime _endDate = DateTime.Now;

    private string _tripsUrl = "api/trip";
    private string _carsUrl = "api/car";
    private string _driversUrl = "api/driver";

    private bool _showClients = false;
    private bool _showTripCounts = false;
    private bool _showTopDrivers = false;
    private bool _showDriverStats = false;
    private bool _showTopClients = false;
    private bool _showDriverCarInfo = false;

    private StatsFormModel formModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDriversAsync();
    }

    private async Task LoadDriversAsync()
    {
        try
        {
            _drivers = await Http.GetFromJsonAsync<List<Driver>>(_driversUrl) ?? new List<Driver>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading drivers: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadClientsStatsAsync()
    {
        try
        {
            DateTime? startDate = formModel.startDate;
            DateTime? endDate = formModel.endDate;

            var url = $"{_tripsUrl}/passengers?startDate={startDate:yyyy-MM-ddTHH:mm:ss}&endDate={endDate:yyyy-MM-ddTHH:mm:ss}";
            _clients = await Http.GetFromJsonAsync<List<Client>>(url) ?? new List<Client>();

            _showClients = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading cars: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadTripCountsAsync()
    {
        try
        {
            var url = $"{_tripsUrl}/trip-counts";
            _tripCounts = await Http.GetFromJsonAsync<List<ClientTripCountDto>>(url) ?? new List<ClientTripCountDto>();

            _showTripCounts = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading trip counts: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadTopDriversAsync()
    {
        try
        {
            var url = $"{_tripsUrl}/top-drivers";
            _topDrivers = await Http.GetFromJsonAsync<List<DriverTripCountDto>>(url) ?? new List<DriverTripCountDto>();

            _showTopDrivers = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading top drivers: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDriverTripStatsAsync()
    {
        try
        {
            var url = $"{_tripsUrl}/driver-trip-stats";
            _driverStats = await Http.GetFromJsonAsync<List<DriverTripStatsDto>>(url) ?? new List<DriverTripStatsDto>();

            _showDriverStats = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading driver stats: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadTopClientsAsync()
    {
        try
        {
            DateTime? startDate = formModel.startDate;
            DateTime? endDate = formModel.endDate;

            var url = $"{_tripsUrl}/top-clients?startDate={startDate:yyyy-MM-ddTHH:mm:ss}&endDate={endDate:yyyy-MM-ddTHH:mm:ss}";
            _topClients = await Http.GetFromJsonAsync<List<ClientTripCountDto>>(url) ?? new List<ClientTripCountDto>();

            _showTopClients = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading top clients: {ex.Message}", Severity.Error);
        }
    }

    private async Task LoadDriverAndCarInfo()
    {
        try
        {
            var url = $"{_carsUrl}/driver/{formModel.driverId}";
            _driverCarInfo = await Http.GetFromJsonAsync<DriverCarInfoDto>(url) ?? new DriverCarInfoDto();

            _showDriverCarInfo = true;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading driver and car info: {ex.Message}", Severity.Error);
        }
    }

    private void ClearForm()
    {
        formModel = new();
    }

    private class StatsFormModel
    {
        public DateTime? startDate { get; set; }
        public DateTime? endDate { get; set; }
        public int driverId { get; set; }
    }
}