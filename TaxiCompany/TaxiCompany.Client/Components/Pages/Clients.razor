@page "/clients"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Clients</PageTitle>

<h1 class ="text-center">Client management service</h1>

<table class="table table-striped w-100">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full name</th>
            <th>Phone number</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (_clients == null || !_clients.Any())
        {
            <tr>
                <td colspan="4" class="text-center">Clients not found</td>
            </tr>
        }
        else
        {
            @foreach (var client in _clients)
            {
                <tr>
                    <td class="align-middle">@client.Id</td>
                    <td class="align-middle">@client.FullName</td>
                    <td class="align-middle">@client.PhoneNumber</td>
                    <td class="text-center align-middle">
                        <button class="btn btn-primary" @onclick="@(() => ShowUpdForm(client.Id))">Edit</button>
                        <button class="btn btn-danger" @onclick="@(() => DeleteClientAsync(client.Id))">Delete</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<h3>@(_isAdd ? "Add client" : "Edit client")</h3>

<EditForm Model="@_currentClient" OnValidSubmit="@HandleFormSubmit" FormName="ClientForm">
    <DataAnnotationsValidator />
    
    <div class="mb-3">
        <label for="full-name" class="form-label">Full name</label>
        <InputText id="full-name" class="form-control" @bind-Value="_currentClient.FullName" />
        <ValidationMessage For="@(() => _currentClient.FullName)" />
    </div>
    
    <div class="mb-3">
        <label for="phone-number" class="form-label">Phone number</label>
        <InputText id="phone-number" class="form-control" @bind-Value="_currentClient.PhoneNumber" />
        <ValidationMessage For="@(() => _currentClient.PhoneNumber)" />
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Cancel</button>
</EditForm>

@code 
{
    private List<Client> _clients = new();
    private Client _currentClient = new() { Id = 0, FullName = "", PhoneNumber = "" };

    private string _clientsUrl = "api/client";

    private bool _isAdd = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadClientsAsync();
    }

    private async Task LoadClientsAsync()
    {
        try
        {
            _clients = await Http.GetFromJsonAsync<List<Client>>(_clientsUrl) ?? new List<Client>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading clients: {ex.Message}", Severity.Error);
        }
    }

    private async Task AddClientAsync()
    {
        try
        {
            var addClient = new ClientDto
            {
                FullName = _currentClient.FullName,
                PhoneNumber = _currentClient.PhoneNumber
            };
            var response = await Http.PostAsJsonAsync(_clientsUrl, addClient);

            if (response.IsSuccessStatusCode)
            {
                ClearForm();
                await LoadClientsAsync();
            }
            else
            {
                Snackbar.Add($"Failed to add client: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding client: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateClientAsync()
    {
        try
        {
            var updateClient = new ClientDto
            {
                FullName = _currentClient.FullName,
                PhoneNumber = _currentClient.PhoneNumber
            };
            var response = await Http.PutAsJsonAsync($"{_clientsUrl}/{_currentClient.Id}", updateClient);

            if (response.IsSuccessStatusCode)
            {
                ClearForm();
                await LoadClientsAsync();
            }
            else
            {
                Snackbar.Add($"Failed to update client: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating client: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteClientAsync(int clientId)
    {
        try
        {
            var response = await Http.DeleteAsync($"{_clientsUrl}/{clientId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadClientsAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete client: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting client: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowUpdForm(int clientId)
    {
        _isAdd = false;

        var response = await Http.GetFromJsonAsync<Client>($"{_clientsUrl}/{clientId}");
        if (response != null) _currentClient = response;
    }

    private void ClearForm()
    {
        _isAdd = true;
        _currentClient = new() { Id = 0, FullName = "", PhoneNumber = "" };
    }

    private async Task HandleFormSubmit()
    {
        if (_isAdd) await AddClientAsync();
        else await UpdateClientAsync();
    }
}


