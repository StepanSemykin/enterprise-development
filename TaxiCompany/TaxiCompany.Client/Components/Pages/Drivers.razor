@page "/drivers"
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>Drivers</PageTitle>

<h1 class="text-center">Driver managment service</h1>

<table class="table table-striped w-100">
    <thead>
        <tr>
            <th>Id</th>
            <th>Full name</th>
            <th>Phone number</th>
            <th>Passport</th>
            <th>Address</th>
            <th>Assigned car</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (_drivers == null || !_drivers.Any())
        {
            <tr>
                <td colspan="7" class="text-center">Drivers not found</td>
            </tr>
        }
        else
        {
            @foreach (var driver in _drivers)
            {
                <tr>
                    <td class="align-middle">@driver.Id</td>
                    <td class="align-middle">@driver.FullName</td>
                    <td class="align-middle">@driver.PhoneNumber</td>
                    <td class="align-middle">@driver.Passport</td>
                    <td class="align-middle">@driver.Address</td>
                    <td class="align-middle">@driver.AssignedCarId</td>
                    <td class="text-center align-middle">
                        <button class="btn btn-primary" @onclick="@(() => ShowUpdForm(driver.Id))">Edit</button>
                        <button class="btn btn-danger" @onclick="@(() => DeleteDriverAsync(driver.Id))">Delete</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

<h3>@(_isAdd ? "Add driver" : "Edit driver")</h3>

<EditForm Model="@_currentDriver" OnValidSubmit=@HandleFormSubmit FormName="DriverForm">
    <div class="mb-3">
        <label for="full-name" class="form-label">Full name</label>
        <InputText id="full-name" class="form-control" @bind-Value="_currentDriver.FullName" />
    </div>
    <div class="mb-3">
        <label for="phone-number" class="form-label">Phone number</label>
        <InputText id="phone-number" class="form-control" @bind-Value="_currentDriver.PhoneNumber" />
    </div>
    <div class="mb-3">
        <label for="passport" class="form-label">Passport</label>
        <InputText id="passport" class="form-control" @bind-Value="_currentDriver.Passport" />
    </div>
    <div class="mb-3">
        <label for="address" class="form-label">Address</label>
        <InputText id="address" class="form-control" @bind-Value="_currentDriver.Address" />
    </div>
    <button type="submit" class="btn btn-success">Save</button>
    <button type="button" class="btn btn-secondary" @onclick="ClearForm">Cancel</button>
</EditForm>

@code 
{
    private List<Driver> _drivers = new();
    private Driver _currentDriver = new() { Id = 0, FullName = "", PhoneNumber = "", Address = "", Passport = "", AssignedCarId = 0};

    private string _driversUrl = "api/driver";

    private bool _isAdd = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDriversAsync();
    }

    private async Task LoadDriversAsync()
    {
        try
        {
            _drivers = await Http.GetFromJsonAsync<List<Driver>>(_driversUrl) ?? new List<Driver>();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading drivers: {ex.Message}", Severity.Error);
        }
    }

    private async Task AddDriverAsync()
    {
        try
        {
            var addDriver = new DriverDto
            {
                FullName = _currentDriver.FullName,
                PhoneNumber = _currentDriver.PhoneNumber,
                Passport = _currentDriver.Passport,
                Address = _currentDriver.Address
            };
            var response = await Http.PostAsJsonAsync(_driversUrl, addDriver);
            if (response.IsSuccessStatusCode)
            {
                ClearForm();
                await LoadDriversAsync();
            }
            else
            {
                Snackbar.Add($"Failed to add driver: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding driver: {ex.Message}", Severity.Error);
        }
    }

    private async Task UpdateDriverAsync()
    {
        try
        {
            var updateDriver = new DriverDto
            {
                FullName = _currentDriver.FullName,
                PhoneNumber = _currentDriver.PhoneNumber,
                Passport = _currentDriver.Passport,
                Address = _currentDriver.Address
            };
            var response = await Http.PutAsJsonAsync($"{_driversUrl}/{_currentDriver.Id}", updateDriver);
            if (response.IsSuccessStatusCode)
            {
                ClearForm();
                await LoadDriversAsync();
            }
            else
            {
                Snackbar.Add($"Failed to update driver: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating driver: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDriverAsync(int driverId)
    {
        try
        {
            var response = await Http.DeleteAsync($"{_driversUrl}/{driverId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadDriversAsync();
            }
            else
            {
                Snackbar.Add($"Failed to delete driver: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting driver: {ex.Message}", Severity.Error);
        }
    }

    private async Task ShowUpdForm(int driverId)
    {
        _isAdd = false;
        var response = await Http.GetFromJsonAsync<Driver>($"{_driversUrl}/{driverId}");
        if (response != null) _currentDriver = response;
    }

    private void ClearForm()
    {
        _isAdd = true;
        _currentDriver = new Driver() { Id = 0, FullName = "", PhoneNumber = "", Address = "", Passport = "", AssignedCarId = 0};
    }

    private async Task HandleFormSubmit()
    {
        if (_isAdd) await AddDriverAsync();
        else await UpdateDriverAsync();
    }
}